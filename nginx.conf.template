# Frontend + proxy de /api/ al Gateway (mismo origen: el bundle no lleva ninguna URL fija).
# La imagen oficial de nginx sustituye ${GATEWAY_UPSTREAM} y ${NGINX_RESOLVER} al arrancar.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolver + variable: el Gateway se resuelve en cada peticion (en ECS su IP cambia al redesplegar).
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $gateway ${GATEWAY_UPSTREAM};

    location /api/ {
        proxy_pass $gateway;
        # Host original: el Gateway ve la peticion como mismo origen y no aplica CORS.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
